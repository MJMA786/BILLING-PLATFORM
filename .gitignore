# ==========================================
# Subly Platform - Root .gitignore
# ==========================================

# ------------------------------------------
# Environment & Security Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env

# ------------------------------------------
# Python & Virtual Environment
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# ------------------------------------------
# Node.js & React Frontend
# ------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
.vite/
frontend/.vite/
.npm/

# ------------------------------------------
# Database & Generated Files
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
backend/app.db
invoices_pdf/
*.pdf

# ------------------------------------------
# Logs & Cache
# ------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pytest_cache/
.mypy_cache/
.cache/
.coverage
htmlcov/

# ------------------------------------------
# Operating System & IDEs
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project